{
  "name": "prescription-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev -w @prescription/backend",
    "dev:frontend": "npm run dev -w @prescription/frontend",
    "build": "npm run build -w @prescription/backend && npm run build -w @prescription/frontend",
    "test": "npm run test -w @prescription/backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}